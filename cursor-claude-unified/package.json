{
  "name": "cursor-ai-supercharger",
  "displayName": "🚀 Cursor AI Supercharger",
  "description": "Automatically enhances Cursor AI chat with multi-LLM routing, cost optimization, and N8N integration",
  "version": "3.0.0",
  "publisher": "pbradygeorgen",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Snippets",
    "AI"
  ],
  "keywords": [
    "cursor",
    "ai",
    "chat",
    "enhancement",
    "multi-llm",
    "cost-optimization",
    "n8n",
    "claude",
    "openai",
    "gemini",
    "automatic"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:cursor-ai-supercharger.activate"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cursor-ai-supercharger.activate",
        "title": "🚀 Activate Cursor AI Supercharger",
        "category": "Cursor AI Supercharger"
      },
      {
        "command": "cursor-ai-supercharger.enhanceFileContext",
        "title": "📁 Inject Enhanced File Context for Cursor AI",
        "category": "Cursor AI Supercharger"
      },
      {
        "command": "cursor-ai-supercharger.provideCodeSuggestions",
        "title": "🤖 Generate Code Suggestions for Cursor AI",
        "category": "Cursor AI Supercharger"
      },
      {
        "command": "cursor-ai-supercharger.analyzeWorkspace",
        "title": "🏗️ Analyze Workspace for Cursor AI Context",
        "category": "Cursor AI Supercharger"
      },
      {
        "command": "cursor-ai-supercharger.integrateN8N",
        "title": "🔄 Integrate with N8N Workflows",
        "category": "Cursor AI Supercharger"
      },
      {
        "command": "cursor-ai-supercharger.showContextStatus",
        "title": "📊 Show Enhanced Context Status",
        "category": "Cursor AI Supercharger"
      },
      {
        "command": "cursor-ai-supercharger.toggleEnhancement",
        "title": "🔄 Toggle Cursor AI Enhancement",
        "category": "Cursor AI Supercharger"
      },
      {
        "command": "cursor-ai-supercharger.quickFileAnalysis",
        "title": "⚡ Quick File Analysis for Cursor AI",
        "category": "Cursor AI Supercharger"
      },
      {
        "command": "cursor-ai-supercharger.enhanceSelection",
        "title": "✨ Enhance Selection for Cursor AI",
        "category": "Cursor AI Supercharger"
      },
      {
        "command": "cursor-ai-supercharger.showInsights",
        "title": "🧠 Show Integration Insights",
        "category": "Cursor AI Supercharger"
      },
      {
        "command": "cursor-ai-supercharger.sendTaskToN8N",
        "title": "🚀 Send Task to Multi-LLM System (N8N)",
        "category": "Cursor AI Supercharger"
      },
      {
        "command": "cursor-ai-supercharger.showLLMStatus",
        "title": "🤖 Show Real-time LLM Selection Status",
        "category": "Cursor AI Supercharger"
      },
      {
        "command": "cursor-ai-supercharger.showCostOptimization",
        "title": "💰 Show Cost Optimization Dashboard",
        "category": "Cursor AI Supercharger"
      },
      {
        "command": "cursor-ai-supercharger.autoEnhanceChat",
        "title": "🎯 Auto-Enhance Current Chat Session",
        "category": "Cursor AI Supercharger"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "cursor-ai-supercharger.enhanceFileContext",
          "when": "editorTextFocus"
        },
        {
          "command": "cursor-ai-supercharger.provideCodeSuggestions",
          "when": "editorTextFocus && editorHasSelection"
        },
        {
          "command": "cursor-ai-supercharger.analyzeWorkspace",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "cursor-ai-supercharger.quickFileAnalysis",
          "when": "editorTextFocus"
        },
        {
          "command": "cursor-ai-supercharger.enhanceSelection",
          "when": "editorTextFocus && editorHasSelection"
        },
        {
          "command": "cursor-ai-supercharger.autoEnhanceChat",
          "when": "true"
        }
      ],
      "editor/context": [
        {
          "command": "cursor-ai-supercharger.enhanceFileContext",
          "when": "editorTextFocus",
          "group": "cursor-ai-supercharger"
        },
        {
          "command": "cursor-ai-supercharger.provideCodeSuggestions",
          "when": "editorTextFocus && editorHasSelection",
          "group": "cursor-ai-supercharger"
        },
        {
          "command": "cursor-ai-supercharger.quickFileAnalysis",
          "when": "editorTextFocus",
          "group": "cursor-ai-supercharger"
        }
      ]
    },
    "configuration": {
      "title": "Cursor AI Supercharger",
      "properties": {
        "cursor-ai-supercharger.autoEnhance": {
          "type": "boolean",
          "default": true,
          "description": "Automatically enhance Cursor AI chat sessions"
        },
        "cursor-ai-supercharger.costOptimization": {
          "type": "boolean",
          "default": true,
          "description": "Enable cost optimization for AI model selection"
        },
        "cursor-ai-supercharger.n8nEndpoint": {
          "type": "string",
          "default": "https://n8n.pbradygeorgen.com",
          "description": "N8N workflow endpoint for enhanced AI routing"
        },
        "cursor-ai-supercharger.defaultPriority": {
          "type": "string",
          "enum": [
            "cost",
            "speed",
            "quality",
            "balanced"
          ],
          "default": "balanced",
          "description": "Default priority for AI model selection"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "18.x",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/pbradygeorgen/cursor-ai-supercharger.git"
  },
  "bugs": {
    "url": "https://github.com/pbradygeorgen/cursor-ai-supercharger/issues"
  },
  "homepage": "https://github.com/pbradygeorgen/cursor-ai-supercharger#readme",
  "license": "MIT",
  "publisherDisplayName": "Brady Georgens"
}

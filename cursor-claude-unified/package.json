{
  "name": "cursor-claude-unified",
  "displayName": "Cursor AI Chat Extender",
  "description": "TRULY extends Cursor's native AI chat with enhanced context, file analysis, and N8N integration",
  "version": "2.0.0",
  "publisher": "pbradygeorgen",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "cursor",
    "ai",
    "chat",
    "enhancement",
    "context",
    "n8n",
    "claude",
    "file-analysis"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cursor-claude.enhanceFileContext",
        "title": "📁 Inject Enhanced File Context for Cursor AI",
        "category": "Cursor AI Enhancement"
      },
      {
        "command": "cursor-claude.provideCodeSuggestions",
        "title": "🤖 Generate Code Suggestions for Cursor AI",
        "category": "Cursor AI Enhancement"
      },
      {
        "command": "cursor-claude.analyzeWorkspace",
        "title": "🏗️ Analyze Workspace for Cursor AI Context",
        "category": "Cursor AI Enhancement"
      },
      {
        "command": "cursor-claude.integrateN8N",
        "title": "🔄 Integrate with N8N Workflows",
        "category": "Cursor AI Enhancement"
      },
      {
        "command": "cursor-claude.showContextStatus",
        "title": "📊 Show Enhanced Context Status",
        "category": "Cursor AI Enhancement"
      },
      {
        "command": "cursor-claude.toggleEnhancement",
        "title": "🔄 Toggle Cursor AI Enhancement",
        "category": "Cursor AI Enhancement"
      },
      {
        "command": "cursor-claude.quickFileAnalysis",
        "title": "⚡ Quick File Analysis for Cursor AI",
        "category": "Cursor AI Enhancement"
      },
      {
        "command": "cursor-claude.enhanceSelection",
        "title": "✨ Enhance Selection for Cursor AI",
        "category": "Cursor AI Enhancement"
      },
      {
        "command": "cursor-claude.showInsights",
        "title": "🧠 Show Integration Insights",
        "category": "Cursor AI Enhancement"
      },
      {
        "command": "cursor-claude.sendTaskToN8N",
        "title": "🚀 Send Task to Unified AI System (N8N)",
        "category": "Cursor AI Enhancement"
      },
      {
        "command": "cursor-claude.showLLMStatus",
        "title": "🤖 Show Real-time LLM Selection Status",
        "category": "Cursor AI Enhancement"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "cursor-claude.enhanceFileContext",
          "when": "editorTextFocus"
        },
        {
          "command": "cursor-claude.provideCodeSuggestions",
          "when": "editorTextFocus && editorHasSelection"
        },
        {
          "command": "cursor-claude.analyzeWorkspace",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "cursor-claude.integrateN8N",
          "when": "true"
        },
        {
          "command": "cursor-claude.showContextStatus",
          "when": "true"
        },
        {
          "command": "cursor-claude.toggleEnhancement",
          "when": "true"
        },
        {
          "command": "cursor-claude.quickFileAnalysis",
          "when": "editorTextFocus"
        },
        {
          "command": "cursor-claude.enhanceSelection",
          "when": "editorTextFocus && editorHasSelection"
        },
        {
          "command": "cursor-claude.showInsights",
          "when": "true"
        },
        {
          "command": "cursor-claude.sendTaskToN8N",
          "when": "true"
        },
        {
          "command": "cursor-claude.showLLMStatus",
          "when": "true"
        }
      ],
      "editor/context": [
        {
          "command": "cursor-claude.enhanceFileContext",
          "group": "cursor-ai-enhancement",
          "when": "editorTextFocus"
        },
        {
          "command": "cursor-claude.provideCodeSuggestions",
          "group": "cursor-ai-enhancement",
          "when": "editorTextFocus && editorHasSelection"
        },
        {
          "command": "cursor-claude.quickFileAnalysis",
          "group": "cursor-ai-enhancement",
          "when": "editorTextFocus"
        },
        {
          "command": "cursor-claude.enhanceSelection",
          "group": "cursor-ai-enhancement",
          "when": "editorTextFocus && editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "Cursor AI Chat Extender",
      "properties": {
        "cursor-claude.autoEnhanceFileContext": {
          "type": "boolean",
          "default": true,
          "description": "Automatically enhance file context for Cursor AI"
        },
        "cursor-claude.autoAnalyzeWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Automatically analyze workspace for Cursor AI context"
        },
        "cursor-claude.n8NIntegration": {
          "type": "boolean",
          "default": true,
          "description": "Enable N8N workflow integration"
        },
        "cursor-claude.enhancementLevel": {
          "type": "string",
          "enum": [
            "minimal",
            "standard",
            "comprehensive"
          ],
          "default": "standard",
          "description": "Level of enhancement for Cursor AI"
        },
        "cursor-claude.n8NEndpoint": {
          "type": "string",
          "default": "https://n8n.pbradygeorgen.com",
          "description": "N8N instance endpoint for unified AI routing"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/pbradygeorgen/cursor-claude-unified.git"
  },
  "bugs": {
    "url": "https://github.com/pbradygeorgen/cursor-claude-unified/issues"
  },
  "homepage": "https://github.com/pbradygeorgen/cursor-claude-unified#readme",
  "license": "MIT"
}

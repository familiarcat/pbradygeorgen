{
  "name": "cursor-claude-llm-collaboration",
  "displayName": "Cursor-Claude LLM Collaboration",
  "description": "Revolutionary AI collaboration system with democratic LLM selection and N8N integration",
  "version": "1.0.0",
  "publisher": "pbradygeorgen",
  "repository": {
    "type": "git",
    "url": "https://github.com/pbradygeorgen/cursor-claude-llm-collaboration.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "AI"
  ],
  "keywords": [
    "ai",
    "claude",
    "cursor",
    "llm",
    "collaboration",
    "n8n",
    "openrouter"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursor-claude-llm-collaboration.startLLMCollaboration",
        "title": "🚀 Start LLM Collaboration",
        "category": "Claude-Cursor"
      },
      {
        "command": "cursor-claude-llm-collaboration.quickStart",
        "title": "⚡ Quick Start LLM Hub",
        "category": "Claude-Cursor"
      },
      {
        "command": "cursor-claude-llm-collaboration.democraticSelection",
        "title": "🗳️ Democratic LLM Selection",
        "category": "Claude-Cursor"
      },
      {
        "command": "cursor-claude-llm-collaboration.showModelScores",
        "title": "📊 Show Model Confidence Scores",
        "category": "Claude-Cursor"
      },
      {
        "command": "cursor-claude-llm-collaboration.deployN8NWorkflow",
        "title": "🚀 Deploy N8N Workflow",
        "category": "Claude-Cursor"
      },
      {
        "command": "cursor-claude-llm-collaboration.showConfiguration",
        "title": "🔧 Show Configuration",
        "category": "Claude-Cursor"
      },
      {
        "command": "cursor-claude-llm-collaboration.showSubAgentInsights",
        "title": "🤖 Show Sub-Agent Orchestration Insights",
        "category": "Claude-Cursor"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "llm-collaboration",
          "title": "🚀 LLM Collaboration",
          "icon": "$(rocket)"
        }
      ]
    },
    "views": {
      "llm-collaboration": [
        {
          "id": "llm-collaboration-panel",
          "name": "🤖 AI Crew",
          "when": "true"
        },
        {
          "id": "llm-collaboration-chat",
          "name": "💬 Chat Interface",
          "when": "true"
        },
        {
          "id": "llm-collaboration-insights",
          "name": "📊 Sub-Agent Insights",
          "when": "true"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "llm-collaboration-panel",
        "contents": "🚀 **Welcome to AI Crew Collaboration!**\n\nYour revolutionary AI collaboration system is ready.\n\n[Start Chat](command:cursor-claude-llm-collaboration.startLLMCollaboration)\n[View Insights](command:cursor-claude-llm-collaboration.showSubAgentInsights)\n[Configuration](command:cursor-claude-llm-collaboration.showConfiguration)"
      },
      {
        "view": "llm-collaboration-chat",
        "contents": "💬 **Interactive AI Chat**\n\nReady for context-grounded conversations with your AI crew.\n\n[Open Chat](command:cursor-claude-llm-collaboration.startLLMCollaboration)"
      },
      {
        "view": "llm-collaboration-insights",
        "contents": "📊 **Sub-Agent Performance**\n\nMonitor your AI crew's decision-making and LLM selection.\n\n[View Insights](command:cursor-claude-llm-collaboration.showSubAgentInsights)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "cursor-claude-llm-collaboration.startLLMCollaboration",
          "when": "true"
        },
        {
          "command": "cursor-claude-llm-collaboration.showSubAgentInsights",
          "when": "true"
        }
      ],
      "view/title": [
        {
          "command": "cursor-claude-llm-collaboration.startLLMCollaboration",
          "when": "view == llm-collaboration-panel",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Cursor-Claude LLM Collaboration",
      "properties": {
        "cursor-claude.n8nBaseUrl": {
          "type": "string",
          "default": "https://n8n.pbradygeorgen.com",
          "description": "N8N base URL for workflow deployment"
        },
        "cursor-claude.openRouterApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenRouter API key for LLM access"
        },
        "cursor-claude.claudeApiKey": {
          "type": "string",
          "default": "",
          "description": "Claude API key for direct access"
        },
        "cursor-claude.autoDeploy": {
          "type": "boolean",
          "default": true,
          "description": "Automatically deploy N8N workflows"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "build": "npm run compile && npm run package",
    "dev": "npm run compile && npm run watch"
  },
  "devDependencies": {
    "@types/node": "^16.x",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.11.0"
  }
}

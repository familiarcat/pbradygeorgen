# Development Dockerfile for Next.js with n8n integration
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Install dependencies for development
RUN apk add --no-cache libc6-compat

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Expose port
EXPOSE 3000

# Set environment variables
ENV NODE_ENV=development
ENV N8N_BASE_URL=https://n8n.pbradygeorgen.com

# Start development server
CMD ["npm", "run", "dev"]

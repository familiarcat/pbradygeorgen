        {
            "id": "response_aggregator",
            "name": "Crew Response Aggregator",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1400,
                900
            ],
            "parameters": {
                "jsCode": "// Aggregate all crew member responses\nconst crewResponses = $input.all();\nconst aggregatedResponse = {\n    mission_id: $json.mission_id,\n    timestamp: new Date().toISOString(),\n    crew_responses: crewResponses.map(response => ({\n        crew_member: response.crew_member || response.name || 'Unknown',\n        response: response.response || response.message || response.content || 'No response',\n        confidence: response.confidence || 0.8,\n        model: response.model || 'openai/gpt-4o-mini'\n    })),\n    mission_summary: \"Mission completed by AlexAI Optimized Crew\",\n    crew_size: crewResponses.length,\n    deployment_info: {\n        deployment_date: new Date().toISOString(),\n        crew_version: \"2.0-optimized\",\n        total_members: 9,\n        mission_coordinator: \"Active\",\n        response_aggregator: \"Operational\"\n    },\n    next_actions: crewResponses\n        .filter(r => r.next_actions)\n        .flatMap(r => r.next_actions)\n        .filter((action, index, arr) => arr.indexOf(action) === index)\n};\n\nreturn aggregatedResponse;"
            }
        }

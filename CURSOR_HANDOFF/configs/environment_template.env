# 🌍 Environment Variables Template - Claude Crew System
# Copy this file to .env and fill in your actual values

# =============================================================================
# CLAUDE AI CONFIGURATION
# =============================================================================

# Anthropic Claude API Key (Required)
# Get from: https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-api03-YOUR_ACTUAL_API_KEY_HERE

# Claude Model Selection
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Claude API Configuration
CLAUDE_MAX_TOKENS=4000
CLAUDE_TEMPERATURE=0.7

# =============================================================================
# N8N INTEGRATION
# =============================================================================

# N8N Base URL (Required)
N8N_BASE_URL=https://n8n.pbradygeorgen.com

# N8N API Key (Required for workflow management)
N8N_API_KEY=YOUR_N8N_API_KEY_HERE

# N8N Webhook Base URL
N8N_WEBHOOK_BASE=https://n8n.pbradygeorgen.com/webhook

# N8N Connection Timeout (seconds)
N8N_TIMEOUT=30

# =============================================================================
# SUPABASE MEMORY SYSTEM
# =============================================================================

# Supabase Project URL (Required for memory system)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (Required)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# Supabase Anonymous Key (Optional, for client-side access)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Memory Retention Settings
MEMORY_RETENTION_DAYS=90
MEMORY_MAX_ENTRIES=10000

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Application Port
PORT=3000

# Node.js Memory Configuration
NODE_OPTIONS=--max-old-space-size=4096

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Log Level
LOG_LEVEL=info

# Enable Debug Mode
DEBUG=false

# Enable Performance Monitoring
ENABLE_MONITORING=true

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Session Secret (Required for production)
SESSION_SECRET=YOUR_SESSION_SECRET_HERE

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=100

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================

# Enable Test Mode
ENABLE_TEST_MODE=false

# Mock Data Fallback
ENABLE_MOCK_FALLBACK=true

# Test API Keys (for development only)
TEST_CLAUDE_API_KEY=sk-ant-api03-TEST_KEY_FOR_DEVELOPMENT
TEST_N8N_API_KEY=TEST_N8N_KEY_FOR_DEVELOPMENT

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Build Configuration
NEXT_PUBLIC_BUILD_ID=YOUR_BUILD_ID
NEXT_PUBLIC_VERSION=1.0.0

# CDN Configuration
NEXT_PUBLIC_CDN_URL=https://your-cdn.com

# =============================================================================
# INTEGRATION WEBHOOKS
# =============================================================================

# Webhook Secret (for webhook validation)
WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# External Service Webhooks
EXTERNAL_WEBHOOK_URL=https://your-service.com/webhook
EXTERNAL_WEBHOOK_TOKEN=YOUR_WEBHOOK_TOKEN_HERE

# =============================================================================
# BACKUP & RECOVERY
# =============================================================================

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# Recovery Configuration
RECOVERY_MODE_ENABLED=false
RECOVERY_BACKUP_LOCATION=/backups

# =============================================================================
# NOTIFICATIONS & ALERTS
# =============================================================================

# Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=YOUR_EMAIL_PASSWORD_HERE

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#alerts

# =============================================================================
# CUSTOM CONFIGURATION
# =============================================================================

# Add any custom environment variables below
CUSTOM_FEATURE_FLAG=true
CUSTOM_API_ENDPOINT=https://your-custom-api.com

# =============================================================================
# NOTES & INSTRUCTIONS
# =============================================================================

# 1. Copy this file to .env in your project root
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit .env files to version control
# 4. Use different values for development, staging, and production
# 5. Regularly rotate API keys and secrets
# 6. Monitor environment variable usage for security

# Required Variables (must be set):
# - CLAUDE_API_KEY
# - N8N_BASE_URL
# - SUPABASE_URL
# - SUPABASE_SERVICE_ROLE_KEY

# Optional Variables (have sensible defaults):
# - All other variables have default values or are optional
